# No credentials are needed for npm run demo or npm test.
# For live reads, either run npm run connect, or provide BOTH values below.
# Blank or partial overrides fail. Never commit real credentials.
# PINGROOM_TOKEN=your-robot-credential
# PINGROOM_ROOM=ROOMCODE1234
#
# .env and config.json are read relative to this project, not the shell directory.
# Credentials: .pingroom/credentials.json
# Cursor and private event journal: .journal/state.json
# Private JSON exports: .journal/exports/
